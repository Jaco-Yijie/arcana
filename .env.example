# ══════════════════════════════════════════════════════════════
# Arcana —— 环境变量
#
# 复制成 .env 后填写。.env 已在 .gitignore 里，绝不要提交真实 Key。
# 全部变量都有可用默认值：**不配任何一个也能 npm run dev 跑起来**
# （解读会走本地示例数据，牌面走 public/ 里的本地资产）。
# ══════════════════════════════════════════════════════════════

# ── 解读服务（只在服务端读取） ──────────────────────────────

# DeepSeek API Key。
# 【绝不能加 VITE_ 前缀】—— 加了就会被打进前端产物，等于公开发布密钥。
# 不填 = 走本地示例解读（Mock），UI 完整可用。
DEEPSEEK_API_KEY=

# deepseek-v4-flash（推荐，实测约 55–60s 出一份完整解读）
# deepseek-v4-pro  （质量更高，但实测 90–180s+，容易触发超时）
DEEPSEEK_MODEL=deepseek-v4-flash

# 强制指定 provider。不设时：有 Key 用 deepseek，无 Key 用 mock。
# 设成 deepseek 却没有 Key 会明确报错，不静默降级。
# READING_PROVIDER=deepseek

# 解读服务监听端口。生产下 npm start 用同一个进程托管 dist/ 与 /api。
# PORT=8787

# 以下一般不用改。两个模型都是推理模型，max_tokens 把 reasoning_tokens 一起算，
# 而推理开销波动很大（同一 prompt 实测 1792 ~ 7528 token），给小了 JSON 会被截断。
# DEEPSEEK_MAX_TOKENS=16000
# DEEPSEEK_TIMEOUT_MS=180000
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_TEMPERATURE=0.7
# 想更快更省可设 low；关闭推理用 minimal（质量会下降，解读会变浅）
# DEEPSEEK_REASONING_EFFORT=

# ── 牌面资产根（前端，会进 bundle —— 这里只能放公开信息） ────

# 390 张牌面共约 139MB。默认从应用自己的 public/assets/decks 提供，
# 部署时可以整体挪到 CDN / 对象存储，只改这一个变量：
#
#   开发 / 本地构建   不设置        → /assets/decks（走 public/，零配置可跑）
#   生产（CDN）       设成绝对 URL  → <base>/<deckId>/cards/<cardId>.webp?r=<rev>
#
# 末尾不要带斜杠（带了也会被自动去掉）。厂商中立：任何能按路径提供静态文件的
# 对象存储或 CDN 都可以，资产目录结构原样上传即可。
# VITE_DECK_ASSET_BASE_URL=https://assets.example.com/arcana/decks

# ──────────────────────────────────────────────────────────────
# CSP_MODE —— 内容安全策略（服务端 · 运行期生效）
# ──────────────────────────────────────────────────────────────
#
#   report-only（默认）  违规照常放行，但上报到 /api/csp-report 并打进服务端日志
#   enforce              违规直接拦截
#   off                  不发 CSP 头（其余安全头照常发）
#
# CSP 是少数「配错了不报错、只会让产品悄悄坏掉」的东西 —— 拦掉的是资源，
# 表现是牌面空白或动画失效，而服务端一切正常、日志全绿。
# 所以默认 report-only：先观察一轮，确认零违规后再切 enforce，不改一行代码。
#
# img-src 里的牌面来源**从构建产物 dist/arcana-build.json 读**，不读这里的
# VITE_DECK_ASSET_BASE_URL —— 那是构建期的事实，两者可能不一致。
# CSP_MODE=report-only

# ── User System V1（仅服务端；启用账号功能必须配置） ──
# 连接到已创建的 PostgreSQL 数据库，勿加 VITE_ 前缀。
DATABASE_URL=
# 至少 32 字节随机密钥；通过环境变量或未提交的 .env 提供。
JWT_SECRET=
# 浏览器访问的完整 origin，无末尾斜杠；开发默认自动使用请求 Host。
# APP_ORIGIN=http://localhost:5173
# 生产必须设置 NODE_ENV=production、APP_ORIGIN=https://你的域名 并使用 HTTPS。

# 后台运营自然日的 IANA 时区；数据库连接保持 UTC。
APP_TIMEZONE=Asia/Shanghai

# ── Tarot Visual Semantic Layer（开发期批处理，用户运行时用不到）────────
# 牌组视觉语义由 `npm run visual:semantics` 离线生成，结果提交进仓库。
# 用户占卜时只读 src/data/deckVisualSemantics/*.json，**不会调用任何视觉模型**。
# API Key 复用上面的 DEEPSEEK_API_KEY，不需要第二套。

# 支持图片输入的模型。2026-09 实测只有 deepseek-flash（DeepSeek-V4.1-Flash）可用；
# deepseek-v4-pro 是纯文本模型。与 Reading / Intake 的模型配置互不影响。
DEEPSEEK_VISION_MODEL=deepseek-flash
# 单张图片的超时。一张 1080×1800 的 webp 实测 4–7 秒
DEEPSEEK_VISION_TIMEOUT_MS=90000
# 并发。默认 2 稳定不触发 429；批量重跑时可以调到 3
DEEPSEEK_VISION_CONCURRENCY=2
# 一条完整视觉语义约 700–1100 token
DEEPSEEK_VISION_MAX_TOKENS=2400
