# Arcana 解读服务 —— systemd 单元
#
# 安装：
#   sudo cp deploy/arcana.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now arcana
#
# 查看日志：  sudo journalctl -u arcana -f
# 重启：      sudo systemctl restart arcana

[Unit]
Description=Arcana Tarot Reading Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/arcana
# 端口从 .env 读（EnvironmentFile 在下面）。默认 8080。
#
# 为什么不是 80：大陆云服务器**未备案时 80/443 会被封**，
# 而换成 8080 这类非标准端口 + IP 直连就不需要备案。
# 对「发给朋友试用」这个阶段，这是把成本从 ¥300/年 降到 ¥99/年的关键。
# 香港服务器不受此限制，那边可以直接用 80。
Environment=PORT=8080
Environment=NODE_ENV=production
# API Key 放在这个文件里，权限 600，不进仓库
EnvironmentFile=/opt/arcana/.env
ExecStart=/usr/bin/npm start

Restart=always
RestartSec=3
# 单进程 MVP，日志交给 journald
StandardOutput=journal
StandardError=journal

# 以普通用户运行。
# 8080 不是特权端口，所以不需要 CAP_NET_BIND_SERVICE ——
# 少一项权限就少一分风险。（若改回 80，需要把这两行加回来。）
User=arcana
Group=arcana

# 基本加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/arcana

[Install]
WantedBy=multi-user.target
