{
  "name": "arcana",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "lint": "oxlint",
    "engine:check": "tsx scripts/engine-selfcheck.ts",
    "preview": "vite preview",
    "server": "tsx watch server/index.ts",
    "dev:all": "node scripts/dev.mjs",
    "start": "tsx server/index.ts",
    "reading:check": "tsx scripts/reading-eval.ts",
    "deploy:build": "npm ci && npm run build"
  },
  "dependencies": {
    "framer-motion": "^12.43.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tsx": "^4.23.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
